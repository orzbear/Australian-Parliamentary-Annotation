# Development PostgreSQL only. Copy to .env and choose a non-placeholder password.
POSTGRES_DB=hansard_dev
POSTGRES_USER=hansard
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
HANSARD_DATABASE_URL=postgresql+psycopg://hansard:change-me@127.0.0.1:5432/hansard_dev
HANSARD_PROCESSED_DATA_ROOT=data/processed

# Phase 3 web application. Generate a unique secret of at least 32 characters.
HANSARD_APP_ENV=development
HANSARD_SESSION_SECRET=change-me-generate-a-long-random-development-secret
HANSARD_COOKIE_SECURE=false
HANSARD_ALLOWED_HOSTS=127.0.0.1,localhost
HANSARD_BASE_URL=http://127.0.0.1:8000
HANSARD_SESSION_IDLE_MINUTES=60
HANSARD_SESSION_ABSOLUTE_HOURS=12
HANSARD_MINIMUM_PASSWORD_LENGTH=12
HANSARD_LOGIN_LOCKOUT_FAILURES=5
HANSARD_LOGIN_LOCKOUT_MINUTES=15
HANSARD_LOG_LEVEL=INFO
