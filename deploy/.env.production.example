# Copy to .env.production on the VPS, replace every placeholder, then chmod 600.
HANSARD_DOMAIN=annotator.polisde.tech
ACME_EMAIL=YOUR_EMAIL_ADDRESS
HANSARD_IMAGE_TAG=pilot-20260814

POSTGRES_DB=hansard
POSTGRES_USER=hansard_owner
POSTGRES_PASSWORD=GENERATE_WITH_OPENSSL_RAND_HEX_32
HANSARD_APP_DB_USER=hansard_app
HANSARD_APP_DB_PASSWORD=GENERATE_A_DIFFERENT_OPENSSL_RAND_HEX_32

HANSARD_SESSION_SECRET=GENERATE_A_THIRD_OPENSSL_RAND_HEX_32
HANSARD_SESSION_IDLE_MINUTES=60
HANSARD_SESSION_ABSOLUTE_HOURS=12
HANSARD_MINIMUM_PASSWORD_LENGTH=14
HANSARD_LOGIN_LOCKOUT_FAILURES=5
HANSARD_LOGIN_LOCKOUT_MINUTES=15
HANSARD_LOG_LEVEL=INFO

# Host path used by the backup script. It must not be inside the Git checkout.
HANSARD_BACKUP_DIR=/var/backups/hansard-annotator
