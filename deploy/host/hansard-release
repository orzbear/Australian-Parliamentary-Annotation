#!/bin/sh
set -eu
umask 077

APP_DIR=/opt/hansard-annotator
ENV_FILE=$APP_DIR/.env.production
INCOMING_DIR=/var/lib/hansard-deploy/incoming
RELEASES_DIR=$APP_DIR/releases
LOCK_FILE=/run/lock/hansard-annotator-deploy.lock

fail() {
  echo "Deployment refused: $*" >&2
  exit 1
}

[ "$(id -u)" -eq 0 ] || fail "this command must run as root"
[ "$#" -eq 2 ] || fail "expected commit SHA and archive SHA-256"

commit_sha=$1
expected_checksum=$2
case "$commit_sha" in
  *[!0-9a-f]*|'') fail "invalid commit SHA" ;;
esac
[ "${#commit_sha}" -eq 40 ] || fail "commit SHA must contain 40 characters"
case "$expected_checksum" in
  *[!0-9a-f]*|'') fail "invalid archive checksum" ;;
esac
[ "${#expected_checksum}" -eq 64 ] || fail "checksum must contain 64 characters"

archive=$INCOMING_DIR/release-$commit_sha.tar.gz
[ -f "$archive" ] || fail "release archive is missing"
[ -f "$ENV_FILE" ] || fail "production environment file is missing"
[ "$(stat -c '%a' "$ENV_FILE")" = 600 ] || fail "production environment must have mode 600"

exec 9>"$LOCK_FILE"
flock -n 9 || fail "another production deployment is running"

actual_checksum=$(sha256sum "$archive" | awk '{print $1}')
[ "$actual_checksum" = "$expected_checksum" ] || fail "release checksum mismatch"

tar -tzf "$archive" | while IFS= read -r entry; do
  case "$entry" in
    /*|../*|*/../*|*/..) fail "unsafe archive path" ;;
    Dockerfile|compose.production.yaml|alembic.ini|requirements.lock|pyproject.toml|README.md) ;;
    deploy/*|src/*|migrations/*|config/*) ;;
    scripts/|scripts/conference-codebook-pilot-01-ai-codebook-input-d1d13e895705/) ;;
    scripts/conference-codebook-pilot-01-ai-codebook-input-d1d13e895705/CODEBOOK_CONTEXT.json) ;;
    *) fail "unexpected archive entry: $entry" ;;
  esac
done

if tar -tvzf "$archive" | awk 'substr($1, 1, 1) == "l" || substr($1, 1, 1) == "h" { exit 1 }'; then
  :
else
  fail "archive contains a link"
fi

mkdir -p "$RELEASES_DIR"
release_dir=$RELEASES_DIR/$commit_sha
[ ! -e "$release_dir" ] || fail "this commit has already been staged"
mkdir -m 700 "$release_dir"
trap 'rm -rf "$release_dir"' EXIT HUP INT TERM
tar --extract --gzip --file "$archive" --directory "$release_dir" \
  --no-same-owner --no-same-permissions

for required in Dockerfile compose.production.yaml deploy/scripts/backup.sh deploy/scripts/common.sh deploy/scripts/prune_backups.py deploy/scripts/migrate.sh deploy/scripts/verify.sh; do
  [ -f "$release_dir/$required" ] || fail "release is missing $required"
done
codebook_context=scripts/conference-codebook-pilot-01-ai-codebook-input-d1d13e895705/CODEBOOK_CONTEXT.json
[ -f "$release_dir/$codebook_context" ] || \
  fail "Required frozen V2 CODEBOOK_CONTEXT.json is missing from release artifact."

HANSARD_ENV_FILE=$ENV_FILE sh "$release_dir/deploy/scripts/preflight.sh"
HANSARD_IMAGE_TAG=$commit_sha docker compose \
  --env-file "$ENV_FILE" -f "$release_dir/compose.production.yaml" \
  build web migrate campaign-worker

# The working production database is backed up before any migration or service recreation.
HANSARD_ENV_FILE=$ENV_FILE sh "$APP_DIR/deploy/scripts/backup.sh"
HANSARD_IMAGE_TAG=$commit_sha HANSARD_ENV_FILE=$ENV_FILE \
  sh "$release_dir/deploy/scripts/migrate.sh"
HANSARD_IMAGE_TAG=$commit_sha docker compose \
  --env-file "$ENV_FILE" -f "$release_dir/compose.production.yaml" \
  up -d --no-build web campaign-worker caddy
HANSARD_IMAGE_TAG=$commit_sha HANSARD_ENV_FILE=$ENV_FILE \
  sh "$release_dir/deploy/scripts/verify.sh"

next_link=$APP_DIR/.current-$commit_sha
ln -s "$release_dir" "$next_link"
mv -Tf "$next_link" "$APP_DIR/current"

temporary_env=$(mktemp "$APP_DIR/.env.production.XXXXXX")
awk -v image_tag="$commit_sha" '
  BEGIN { replaced = 0 }
  /^HANSARD_IMAGE_TAG=/ { print "HANSARD_IMAGE_TAG=" image_tag; replaced = 1; next }
  { print }
  END { if (!replaced) print "HANSARD_IMAGE_TAG=" image_tag }
' "$ENV_FILE" > "$temporary_env"
chmod 600 "$temporary_env"
chown --reference="$ENV_FILE" "$temporary_env"
mv "$temporary_env" "$ENV_FILE"

operational_scripts='backup.sh common.sh prune_backups.py'
operational_dir=$APP_DIR/deploy/scripts
operational_stage=$(mktemp -d "$APP_DIR/.backup-operations.XXXXXX")
trap 'rm -rf "$operational_stage"' EXIT HUP INT TERM
for script in $operational_scripts; do
  source=$APP_DIR/current/deploy/scripts/$script
  destination=$operational_dir/$script
  [ -f "$source" ] && [ ! -L "$source" ] || \
    fail "current release is missing operational backup script $script"
  [ ! -L "$destination" ] || \
    fail "stable operational backup path must not be a symlink: $destination"
  if [ -e "$destination" ]; then
    mode=$(stat -c '%a' "$destination")
  else
    mode=644
  fi
  install -o root -g root -m "$mode" "$source" "$operational_stage/$script"
done
for script in $operational_scripts; do
  mv -f "$operational_stage/$script" "$operational_dir/$script"
done
rmdir "$operational_stage"
trap - EXIT HUP INT TERM

rm -f "$archive"
printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$commit_sha" \
  >> /var/log/hansard-annotator-deployments.log
echo "Production deployment completed for $commit_sha"

