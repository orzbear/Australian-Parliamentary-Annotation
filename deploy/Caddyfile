{
	email {$ACME_EMAIL}
	admin off
}

{$HANSARD_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 2MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy web:8000 {
		health_uri /health/ready
		health_headers {
			Host {$HANSARD_DOMAIN}
		}
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format json
	}
}
